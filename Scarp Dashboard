<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Production Scrap Analytics Dashboard</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- SheetJS (XLSX) CDN -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <!-- Google Font (Kanit) -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Kanit', sans-serif; background-color: #0B0E14; color: #E2E8F0; }
        .card { background-color: #151A23; border: 1px solid #262D3D; border-radius: 1rem; }
        .glass-header { background: rgba(21, 26, 35, 0.8); backdrop-filter: blur(12px); }
    </style>
</head>
<body class="p-4 md:p-8 min-h-screen">

    <!-- Top Navigation & Upload -->
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4 glass-header p-4 rounded-2xl border border-[#262D3D] sticky top-2 z-50">
        <div>
            <h1 class="text-2xl font-bold text-white flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-indigo-500 inline-block"></span> Dashboard
            </h1>
            <p class="text-xs text-slate-400">Production Defect & Scrap Expense Analytics</p>
        </div>
        
        <div class="flex items-center gap-3">
            <label class="cursor-pointer bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium px-4 py-2.5 rounded-xl transition shadow-lg shadow-indigo-500/20 flex items-center gap-2">
                📂 เลือกไฟล์ Scrap.xlsx
                <input type="file" id="excelFileInput" accept=".xlsx, .xls" class="hidden" onchange="handleFileUpload(event)">
            </label>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto space-y-6">

        <!-- 4 KPI Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="card p-5">
                <p class="text-xs text-slate-400 font-medium">Total Scrap Expenses</p>
                <h3 class="text-2xl font-bold text-white mt-1" id="kpiTotalCost">฿0.00</h3>
                <span class="text-[10px] text-indigo-400 font-semibold mt-2 inline-block">● Calculated from Quantity × Price</span>
            </div>
            <div class="card p-5">
                <p class="text-xs text-slate-400 font-medium">Total Defect Quantity</p>
                <h3 class="text-2xl font-bold text-white mt-1" id="kpiTotalQty">0 pcs</h3>
                <span class="text-[10px] text-emerald-400 font-semibold mt-2 inline-block">● Total defect units recorded</span>
            </div>
            <div class="card p-5">
                <p class="text-xs text-slate-400 font-medium">Total Incidents</p>
                <h3 class="text-2xl font-bold text-white mt-1" id="kpiTotalCases">0 cases</h3>
                <span class="text-[10px] text-purple-400 font-semibold mt-2 inline-block">● Recorded defect entries</span>
            </div>
            <div class="card p-5">
                <p class="text-xs text-slate-400 font-medium">Top Defect Cause</p>
                <h3 class="text-lg font-bold text-white mt-1 truncate" id="kpiTopProblem">-</h3>
                <span class="text-[10px] text-rose-400 font-semibold mt-2 inline-block">● Highest quantity defect type</span>
            </div>
        </div>

        <!-- Middle Row: Charts -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Daily Bar Chart -->
            <div class="card p-6 lg:col-span-2">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-base font-semibold text-slate-200">📊 Daily Expense Analytics</h3>
                </div>
                <div class="h-64 relative">
                    <canvas id="dailyChart"></canvas>
                </div>
            </div>

            <!-- Department Donut Chart -->
            <div class="card p-6">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-base font-semibold text-slate-200">🍩 Expenses by Department</h3>
                </div>
                <div class="h-64 relative">
                    <canvas id="deptChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Bottom Row: Top Problems & Raw Data Table -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Top Problems Horizontal Bar Chart -->
            <div class="card p-6">
                <h3 class="text-base font-semibold text-slate-200 mb-4">⚠️ Top 5 Defect Problems</h3>
                <div class="h-64 relative">
                    <canvas id="problemChart"></canvas>
                </div>
            </div>

            <!-- Data Log Table -->
            <div class="card p-6 flex flex-col justify-between">
                <h3 class="text-base font-semibold text-slate-200 mb-4">📋 Recent Data Records</h3>
                <div class="overflow-x-auto h-64">
                    <table class="w-full text-left text-xs text-slate-300">
                        <thead class="text-slate-400 bg-[#1E2532] uppercase sticky top-0">
                            <tr>
                                <th class="py-2 px-3">Date</th>
                                <th class="py-2 px-3">Dept</th>
                                <th class="py-2 px-3">Problem</th>
                                <th class="py-2 px-3 text-right">Qty</th>
                                <th class="py-2 px-3 text-right">Amt (฿)</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody" class="divide-y divide-[#262D3D]">
                            <tr>
                                <td colspan="5" class="text-center py-8 text-slate-500">กรุณาเลือกไฟล์ Scrap.xlsx เพื่อเริ่มแสดงข้อมูล</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </main>

    <script>
        let dailyChartInstance = null;
        let deptChartInstance = null;
        let problemChartInstance = null;

        // ฟังก์ชันอ่านไฟล์ Excel
        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (e) {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, { type: 'array' });
                const firstSheetName = workbook.SheetNames[0];
                const worksheet = workbook.Sheets[firstSheetName];
                
                // แปลงเป็น JSON
                let jsonData = XLSX.utils.sheet_to_json(worksheet);
                processAndRenderData(jsonData);
            };
            reader.readAsArrayBuffer(file);
        }

        // ประมวลผลและอัปเดต Dashboard
        function processAndRenderData(data) {
            let totalCost = 0;
            let totalQty = 0;
            let dailyMap = {};
            let deptMap = {};
            let probMap = {};
            let cleanRows = [];

            data.forEach(row => {
                let qty = parseFloat(row['Quantity']) || 0;
                let price = parseFloat(row['Price']) || 0;
                let amt = qty * price;
                let date = row['Date'] || 'Unknown';
                let dept = row['Department'] || 'N/A';
                let prob = row['Problem'] || 'N/A';

                if (qty > 0 || price > 0) {
                    totalCost += amt;
                    totalQty += qty;

                    // Group Daily
                    dailyMap[date] = (dailyMap[date] || 0) + amt;
                    // Group Dept
                    deptMap[dept] = (deptMap[dept] || 0) + amt;
                    // Group Problem
                    probMap[prob] = (probMap[prob] || 0) + qty;

                    cleanRows.push({ date, dept, prob, qty, amt });
                }
            });

            // 1. Update Metrics
            document.getElementById('kpiTotalCost').innerText = '฿' + totalCost.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('kpiTotalQty').innerText = totalQty.toLocaleString() + ' pcs';
            document.getElementById('kpiTotalCases').innerText = cleanRows.length + ' cases';

            let topProblem = Object.keys(probMap).reduce((a, b) => probMap[a] > probMap[b] ? a : b, '-');
            document.getElementById('kpiTopProblem').innerText = topProblem;

            // 2. Render Charts
            renderDailyChart(dailyMap);
            renderDeptChart(deptMap, totalCost);
            renderProblemChart(probMap);

            // 3. Render Data Table
            renderTable(cleanRows);
        }

        function renderDailyChart(dailyMap) {
            const ctx = document.getElementById('dailyChart').getContext('2d');
            if (dailyChartInstance) dailyChartInstance.destroy();

            const labels = Object.keys(dailyMap);
            const dataValues = Object.values(dailyMap);

            dailyChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Expenses (฿)',
                        data: dataValues,
                        backgroundColor: '#6366F1',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: '#94A3B8' } },
                        y: { grid: { color: '#1E293B' }, ticks: { color: '#94A3B8' } }
                    }
                }
            });
        }

        function renderDeptChart(deptMap, totalCost) {
            const ctx = document.getElementById('deptChart').getContext('2d');
            if (deptChartInstance) deptChartInstance.destroy();

            deptChartInstance = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: Object.keys(deptMap),
                    datasets: [{
                        data: Object.values(deptMap),
                        backgroundColor: ['#6366F1', '#A855F7', '#EC4899', '#3B82F6', '#10B981', '#F59E0B'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: { position: 'right', labels: { color: '#94A3B8', font: { size: 11 } } }
                    }
                }
            });
        }

        function renderProblemChart(probMap) {
            const ctx = document.getElementById('problemChart').getContext('2d');
            if (problemChartInstance) problemChartInstance.destroy();

            // Sort Top 5
            const sorted = Object.entries(probMap).sort((a, b) => b[1] - a[1]).slice(0, 5);

            problemChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: sorted.map(item => item[0]),
                    datasets: [{
                        label: 'Defect Quantity',
                        data: sorted.map(item => item[1]),
                        backgroundColor: '#38BDF8',
                        borderRadius: 6
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { color: '#1E293B' }, ticks: { color: '#94A3B8' } },
                        y: { grid: { display: false }, ticks: { color: '#94A3B8' } }
                    }
                }
            });
        }

        function renderTable(rows) {
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '';
            rows.slice(0, 10).forEach(r => {
                tbody.innerHTML += `
                    <tr class="hover:bg-[#1E2532] transition">
                        <td class="py-2 px-3 font-medium text-white">${r.date}</td>
                        <td class="py-2 px-3">${r.dept}</td>
                        <td class="py-2 px-3 truncate max-w-[150px]">${r.prob}</td>
                        <td class="py-2 px-3 text-right text-indigo-400 font-semibold">${r.qty}</td>
                        <td class="py-2 px-3 text-right text-emerald-400 font-semibold">฿${r.amt.toLocaleString(undefined, {minimumFractionDigits: 2})}</td>
                    </tr>
                `;
            });
        }
    </script>
</body>
</html>
