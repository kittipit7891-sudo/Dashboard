EXCEL_FILE = "Scrap.xlsx"

# ==========================================
# 2. โหลดและจัดการข้อมูล
# ==========================================
@st.cache_data(ttl=2)
def load_data():
    if os.path.exists(EXCEL_FILE):
        df = pd.read_excel(
            EXCEL_FILE, 
            usecols=['Date', 'Month', 'Shift', 'Material', 'Model', 'Material name', 'Quantity', 'Problem', 'Pic', 'Department', 'Price']
        )
        df = df.dropna(how='all')
        df['Quantity'] = pd.to_numeric(df['Quantity'], errors='coerce').fillna(0)
        df['Price'] = pd.to_numeric(df['Price'], errors='coerce').fillna(0)
        df['Amt.'] = df['Quantity'] * df['Price']
        return df
    return pd.DataFrame()

def save_data(new_df):
    new_df.to_excel(EXCEL_FILE, index=False)
    st.cache_data.clear()

df = load_data()

# ==========================================
# 3. Sidebar (ตัวกรอง + ฟอร์มกรอกข้อมูล)
# ==========================================
st.sidebar.title("🎛️ Control Panel")

# --- Filters ---
st.sidebar.markdown("### 🔍 ตัวกรองข้อมูล")
if not df.empty:
    month_list = df['Month'].dropna().unique().tolist()
    selected_month = st.sidebar.multiselect("📅 เลือกเดือน (Month)", options=month_list, default=month_list)
    
    day_list = sorted(df['Date'].dropna().unique().tolist())
    selected_day = st.sidebar.multiselect("🗓️ เลือกวันที่ (Day)", options=day_list, default=day_list)
    
    shift_list = df['Shift'].dropna().unique().tolist()
    selected_shift = st.sidebar.multiselect("⏰ เลือกกะ (Shift)", options=shift_list, default=shift_list)
else:
    selected_month, selected_day, selected_shift = [], [], []

st.sidebar.markdown("---")

# --- Quick Data Entry ---
st.sidebar.markdown("### 📝 บันทึกข้อมูลเรียลไทม์")
with st.sidebar.form("entry_form", clear_on_submit=True):
    f_date = st.number_input("วันที่ (Date)", min_value=1, max_value=31, value=1)
    f_month = st.selectbox("เดือน (Month)", ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"], index=7)
    f_shift = st.selectbox("กะ (Shift)", ["Day Shift", "Night Shift"])
    f_dept = st.text_input("แผนก (Department)", placeholder="เช่น PD-B, TF")
    f_mat = st.text_input("รหัสวัสดุ (Material)")
    f_model = st.text_input("โมเดล (Model)")
    f_mat_name = st.text_input("ชื่อวัสดุ (Material Name)")
    f_prob = st.text_input("ปัญหาที่พบ (Problem)")
    f_pic = st.text_input("ผู้รับผิดชอบ (Pic)")
    f_qty = st.number_input("จำนวน (ชิ้น)", min_value=1, step=1)
    f_price = st.number_input("ราคาต่อหน่วย", min_value=0.0)
    
    submit = st.form_submit_button("💾 บันทึกข้อมูลเข้า Excel")
    if submit:
        new_row = pd.DataFrame([{
            'Date': f_date,
            'Month': f_month,
            'Shift': f_shift,
            'Material': f_mat,
            'Model': f_model,
            'Material name': f_mat_name,
            'Quantity': f_qty,
            'Problem': f_prob,
            'Pic': f_pic,
            'Department': f_dept,
            'Price': f_price
        }])
        updated = pd.concat([df.drop(columns=['Amt.'], errors='ignore'), new_row], ignore_index=True)
        save_data(updated)
        st.sidebar.success("บันทึกสำเร็จ!")
        st.rerun()

# กรองข้อมูล
filtered_df = df.copy()
if not filtered_df.empty:
    if selected_month:
        filtered_df = filtered_df[filtered_df['Month'].isin(selected_month)]
    if selected_day:
        filtered_df = filtered_df[filtered_df['Date'].isin(selected_day)]
    if selected_shift:
        filtered_df = filtered_df[filtered_df['Shift'].isin(selected_shift)]

# ==========================================
# 4. Main Dashboard Layout (โทนสีสไตล์ Reference)
# ==========================================
st.markdown("<h1 style='color:#F8FAFC; margin-bottom: 5px;'>Dashboard</h1>", unsafe_allow_html=True)
st.markdown("<p style='color:#94A3B8; margin-bottom: 25px;'>Production Defect & Scrap Expense Analytics</p>", unsafe_allow_html=True)

if filtered_df.empty:
    st.warning("ไม่พบข้อมูลตามตัวกรองที่เลือก")
else:
    # --- Top 4 Metric Cards ---
    total_cost = filtered_df['Amt.'].sum()
    total_qty = filtered_df['Quantity'].sum()
    total_cases = len(filtered_df)
    top_prob = filtered_df.groupby('Problem')['Quantity'].sum().idxmax() if not filtered_df['Problem'].isnull().all() else "-"

    m1, m2, m3, m4 = st.columns(4)
    m1.metric("Total Scrap Expenses", f"฿ {total_cost:,.2f}")
    m2.metric("Total Defect Quantity", f"{total_qty:,.0f} pcs")
    m3.metric("Total Incidents", f"{total_cases} cases")
    m4.metric("Top Defect Cause", str(top_prob))

    st.markdown("<br>", unsafe_allow_html=True)

    # --- Middle Row Charts ---
    c_left, c_right = st.columns([6, 4])

    with c_left:
        st.markdown("<h4 style='color:#E2E8F0;'>📊 Sales & Scrap Daily Analytics</h4>", unsafe_allow_html=True)
        daily_df = filtered_df.groupby('Date')['Amt.'].sum().reset_index()
        fig_bar = px.bar(
            daily_df, x='Date', y='Amt.',
            text_auto='.2s',
            color='Amt.',
            color_continuous_scale=['#4F46E5', '#818CF8', '#C084FC']
        )
        fig_bar.update_layout(
            paper_bgcolor='rgba(0,0,0,0)',
            plot_bgcolor='rgba(0,0,0,0)',
            font=dict(color='#94A3B8'),
            margin=dict(l=10, r=10, t=20, b=10),
            coloraxis_showscale=False,
            xaxis=dict(type='category', showgrid=False),
            yaxis=dict(showgrid=True, gridcolor='#1E293B')
        )
        st.plotly_chart(fig_bar, use_container_width=True)

    with c_right:
        st.markdown("<h4 style='color:#E2E8F0;'>🍩 Expenses by Department</h4>", unsafe_allow_html=True)
        dept_df = filtered_df.groupby('Department')['Amt.'].sum().reset_index()
        
        fig_donut = go.Figure(data=[go.Pie(
            labels=dept_df['Department'],
            values=dept_df['Amt.'],
            hole=.65,
            marker_colors=['#6366F1', '#A855F7', '#EC4899', '#3B82F6', '#10B981', '#F59E0B'],
            textinfo='percent+label',
            insidetextorientation='radial'
        )])
        
        # ใส่ตัวเลขยอดรวมตรงกลางโดนัทแบบในรูปตัวอย่าง
        fig_donut.add_annotation(
            text=f"<b>฿{total_cost:,.0f}</b><br><span style='font-size:12px;color:#94A3B8;'>Total Expense</span>",
            x=0.5, y=0.5, font_size=15, font_color="#F8FAFC", showarrow=False
        )
        
        fig_donut.update_layout(
            paper_bgcolor='rgba(0,0,0,0)',
            plot_bgcolor='rgba(0,0,0,0)',
            font=dict(color='#94A3B8'),
            margin=dict(l=10, r=10, t=20, b=10),
            showlegend=False
        )
        st.plotly_chart(fig_donut, use_container_width=True)

    st.markdown("<br>", unsafe_allow_html=True)

    # --- Bottom Row: Top 5 Issues & Data Table ---
    c_b1, c_b2 = st.columns([5, 5])

    with c_b1:
        st.markdown("<h4 style='color:#E2E8F0;'>⚠️ Top 5 Problem Issues</h4>", unsafe_allow_html=True)
        top_problems = filtered_df.groupby('Problem')['Quantity'].sum().reset_index().sort_values(by='Quantity', ascending=True).tail(5)
        fig_prob = px.bar(
            top_problems, y='Problem', x='Quantity', orientation='h',
            text='Quantity',
            color='Quantity',
            color_continuous_scale=['#38BDF8', '#818CF8']
        )
        fig_prob.update_layout(
            paper_bgcolor='rgba(0,0,0,0)',
            plot_bgcolor='rgba(0,0,0,0)',
            font=dict(color='#94A3B8'),
            margin=dict(l=10, r=10, t=20, b=10),
            coloraxis_showscale=False,
            xaxis=dict(showgrid=True, gridcolor='#1E293B'),
            yaxis=dict(showgrid=False)
        )
        st.plotly_chart(fig_prob, use_container_width=True)

    with c_b2:
        st.markdown("<h4 style='color:#E2E8F0;'>📋 Live Raw Data Log</h4>", unsafe_allow_html=True)
        st.dataframe(
            filtered_df[['Date', 'Month', 'Shift', 'Department', 'Material name', 'Problem', 'Quantity', 'Amt.']]
            .sort_values(by=['Month', 'Date'], ascending=[False, False])
            .head(10),
            use_container_width=True,
            height=290
        )
